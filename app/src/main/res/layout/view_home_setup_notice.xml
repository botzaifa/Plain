<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setupNotice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_plain_panel"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/setupNoticeTitle"
        style="@style/PlainSetupNoticeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/setupNoticeBody"
        style="@style/PlainSetupNoticeBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp" />

    <Button
        android:id="@+id/setupNoticeAction"
        style="@style/PlainButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />
</LinearLayout>
