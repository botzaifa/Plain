<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plain_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/PlainScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin" />

        <TextView
            style="@style/PlainScreenSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:text="@string/settings_subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_plain_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/plain_gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/warningText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:textColor="@color/plain_warning"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            style="@style/PlainSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_apps" />

        <Button
            android:id="@+id/btnBasic"
            style="@style/PlainListButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/basic_apps" />

        <Button
            android:id="@+id/btnRestore"
            style="@style/PlainListButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/restore_defaults" />

        <TextView
            style="@style/PlainSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_security" />

        <Button
            android:id="@+id/btnPasswords"
            style="@style/PlainListButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/change_passwords" />

        <Button
            android:id="@+id/btnRecovery"
            style="@style/PlainListButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/new_recovery_code" />

        <TextView
            style="@style/PlainSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_system" />

        <Button
            android:id="@+id/btnA11y"
            style="@style/PlainListButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_accessibility" />

        <Button
            android:id="@+id/btnHomeSettings"
            style="@style/PlainListButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_home_settings" />

        <Button
            android:id="@+id/btnAppInfo"
            style="@style/PlainListButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_app_info" />

        <Button
            android:id="@+id/btnBlackWallpaper"
            style="@style/PlainListButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/black_wallpaper" />
    </LinearLayout>
</ScrollView>
