<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/changePasswordsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plain_black"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/PlainScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/change_passwords" />

        <TextView
            style="@style/PlainScreenSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="20dp"
            android:text="@string/change_passwords_subtitle" />

        <TextView
            style="@style/PlainSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="0dp"
            android:text="@string/password_level_temp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_plain_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/temp1"
                style="@style/PlainEditText"
                android:layout_marginBottom="12dp"
                android:hint="@string/password_new"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/temp2"
                style="@style/PlainEditText"
                android:hint="@string/password_confirm"
                android:inputType="textPassword" />
        </LinearLayout>

        <TextView
            style="@style/PlainSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/password_level_full" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_plain_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/full1"
                style="@style/PlainEditText"
                android:layout_marginBottom="12dp"
                android:hint="@string/password_new"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/full2"
                style="@style/PlainEditText"
                android:hint="@string/password_confirm"
                android:inputType="textPassword" />
        </LinearLayout>

        <TextView
            style="@style/PlainSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/password_level_admin" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_plain_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/admin1"
                style="@style/PlainEditText"
                android:layout_marginBottom="12dp"
                android:hint="@string/password_new"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/admin2"
                style="@style/PlainEditText"
                android:hint="@string/password_confirm"
                android:inputType="textPassword" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            style="@style/PlainButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/save_changes" />
    </LinearLayout>
</ScrollView>
