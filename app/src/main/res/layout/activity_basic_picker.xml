<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/basicPickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plain_black"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/PlainScreenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/basic_apps"
        android:textSize="22sp" />

    <TextView
        style="@style/PlainScreenSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        android:text="@string/wizard_basic_subtitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/btnSave"
        style="@style/PlainButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/save_changes" />
</LinearLayout>
